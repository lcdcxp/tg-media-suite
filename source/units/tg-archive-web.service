[Unit]
Description=Archive dashboard login gate
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-archive
ExecStart=/usr/bin/python3 /opt/tg-archive/webapp.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/tg-archive

[Install]
WantedBy=multi-user.target
