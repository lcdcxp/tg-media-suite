# ---- Telegram user account (required) ----
# Get these from https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=

# ---- File / folder bots used as the media relay (required) ----
# Comma separated, without the leading @. The user account sends
# "/start getFile_<token>" to these bots to pull full-size media.
FORWARDER_BOT_USERNAMES=
# Which of the bots above is the folder-mode bot (optional).
FORWARDER_FOLDER_BOT=

# ---- Runtime tuning (optional) ----
FORWARDER_DOWNLOAD_CONCURRENCY=3
FORWARDER_DOWNLOAD_RETRIES=3
TZ=Asia/Shanghai
